{
  "schema_version": 2,
  "preset_id": "codex-tiered-v1",
  "label": "Tiered Codex routing (Sol/Luna/Terra/Astra)",
  "runtime": "codex",
  "selection_strategy": "tiered",
  "roles": {
    "manager": {
      "role": "manager",
      "model": "gpt-5.6-sol",
      "reasoning": "medium"
    },
    "worker": {
      "tiers": {
        "simple": {
          "role": "worker",
          "model": "gpt-5.6-terra",
          "reasoning": "medium"
        },
        "normal": {
          "role": "worker",
          "model": "gpt-5.6-terra",
          "reasoning": "medium"
        },
        "complex": {
          "role": "senior_worker",
          "model": "gpt-5.6-sol",
          "reasoning": "high"
        },
        "extreme": {
          "role": "expert_worker",
          "model": "gpt-6-astra",
          "reasoning": "high"
        }
      }
    },
    "reviewer": {
      "role": "reviewer",
      "model": "gpt-5.6-sol",
      "reasoning": "high",
      "fork_turns": "none",
      "read_only": true
    },
    "senior_reviewer": {
      "role": "senior_reviewer",
      "model": "gpt-5.6-sol",
      "reasoning": "high",
      "fork_turns": "none",
      "read_only": true
    },
    "researcher": {
      "role": "researcher",
      "model": "gpt-5.6-luna",
      "reasoning": "low"
    },
    "explorer": {
      "role": "explorer",
      "model": "gpt-5.6-luna",
      "reasoning": "medium"
    },
    "judge": {
      "role": "judge",
      "model": "gpt-6-astra",
      "reasoning": "high",
      "fork_turns": "none",
      "read_only": true
    },
    "architect": {
      "role": "architect",
      "model": "gpt-6-astra",
      "reasoning": "high",
      "fork_turns": "none",
      "read_only": true
    },
    "remote_phase": {
      "reuse_worker": true
    }
  },
  "constraints": {
    "max_children": 4,
    "fast_mode": false
  },
  "policy": {
    "id": "codex-tiered-v1",
    "strict_lifecycle": true,
    "assessment_required": true,
    "local_pass_required": true,
    "review_limit": 15,
    "judge": {
      "failed_review_cycles": 2,
      "reviewer_disagreement": true,
      "architecture_security_uncertainty": true
    }
  }
}
